{
  "name": "context-editor",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first Markdown editor website with preview, persistent Trash, import, and backups.",
  "author": "Aman Ranjan Verma",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config vite.editor.config.ts",
    "build": "npm run build:editor",
    "preview": "npm run build && vite preview --config vite.editor.config.ts",
    "build:editor": "vite build --config vite.editor.config.ts",
    "dev:editor": "vite --config vite.editor.config.ts",
    "preview:editor": "npm run build:editor && vite preview --config vite.editor.config.ts",
    "test": "npm --prefix tests test"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/markdown": "^1.8.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "mermaid": "^11.16.0",
    "monaco-editor": "^0.50.0"
  }
}
